<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Waze Live Map in the map box, OpenStreetMap tiles, and the config server -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The OpenStreetMap map switches to offline maps when there's no signal -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- GPS speedometer -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 11+ package visibility: the app drawer, the map apps and Wavelength -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <package android:name="com.waze" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.tonearm.app" />
    </queries>

    <application
        android:name=".CarLauncherApp"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:resizeableActivity="true"
        android:theme="@style/Theme.CarLauncher">

        <!--
            The HOME entry point. Android keeps the home activity out of split-screen, so this activity only
            forwards to DashboardActivity, a normal activity that can sit next to Waze. See docs/ARCHITECTURE.md.
        -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.CarLauncher.Trampoline">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DashboardActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.spacegoose.carlauncher.dashboard"
            android:resizeableActivity="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lets the media card see and control any app's media session (Spotify, YouTube Music, ...) -->
        <service
            android:name=".media.MediaNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Optional: on Android 7-11, puts the dashboard into split-screen so Waze can open beside it -->
        <service
            android:name=".maps.SplitScreenAccessibilityService"
            android:exported="true"
            android:label="@string/split_helper_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/split_screen_accessibility" />
        </service>
    </application>
</manifest>
